LISTEN_ADDR=:8080
DOCKER_HOST_PATH=unix:///var/run/docker.sock
DB_PATH=data/docker-manager.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# ADMIN_PASSWORD_HASH takes precedence over ADMIN_PASSWORD when set. Prefer
# this in any long-lived deployment so a plaintext password isn't sitting in
# this file — generate one with e.g. `htpasswd -bnBC 10 "" changeme | cut -d: -f2`.
# ADMIN_PASSWORD_HASH=
